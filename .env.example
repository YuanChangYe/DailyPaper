# 复制为 .env（同一目录）并填入真实值。.env 已在 .gitignore 中，不会被提交。
# 格式：KEY=value，等号两边不要空格，值不要加引号。
# GitHub Actions 读不到 .env：云端运行需要在仓库 Settings → Secrets and variables → Actions 中添加同名 Secret。

# Claude（默认：Haiku 筛选、Sonnet 精读）
ANTHROPIC_API_KEY=

# 备选模型（在 config/llm.yaml 中切换 provider 时才需要）
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

# Zotero Web API（可选；默认通过本机 Zotero 桌面端联动，不需要）
# ZOTERO_USER_ID=
# ZOTERO_API_KEY=
