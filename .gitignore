.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.cache/
/site/
.env
*.pyc

# 本机 Zotero 文库导出的索引与兴趣画像（含文库标题），默认不提交
data/zotero_index.json
data/interest_profile.json
logs/

# 网页里编辑提示词时的历史版本
prompts/.history/

# 本机开发工具的会话文件（浏览器预览配置等）
.claude/

# 从本机 ~/.claude/skills 导入的 skill 文本。默认不提交：skill 可能是私有的；
# 想让 GitHub Actions 里的精读也用到它们，删掉下面这行再提交。
/skills/

# 首页封面的原图（没有设置 DAILYPAPER_WORKSPACE 时放在项目里）
/covers/

# 顶会论文池（几万篇标题摘要，本地数据）
data/venues.sqlite*

# 个人数据：课题档案、关注列表、局域网配对令牌、问答记录、检索历史与综述
config/profile.md
config/follow.yaml
config/lan.json
data/qa/
data/searches.jsonl
data/reports/
